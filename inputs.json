{
  "version": 1,
  "groups": ["greeting", "friendship", "play", "win", "loss", "ambient", "decline", "close"],
  "phrases": [
    { "id": "greet", "text": "Hi there!", "group": "greeting" },
    { "id": "hello", "text": "Hello!", "group": "greeting" },
    { "id": "good-to-see", "text": "Good to see you!", "group": "greeting" },
    { "id": "hey-buddy", "text": "Hey, buddy!", "group": "greeting" },

    { "id": "be-friends", "text": "Want to be friends?", "group": "friendship" },
    { "id": "yay", "text": "Yay!", "group": "friendship" },

    { "id": "lets-play", "text": "Let's play a game.", "group": "play" },
    { "id": "got-time", "text": "Got time for a round?", "group": "play" },
    { "id": "watch-this", "text": "Watch this!", "group": "play" },

    { "id": "nice-one", "text": "Nice one!", "group": "win" },
    { "id": "well-played", "text": "Well played!", "group": "win" },
    { "id": "you-got-me", "text": "You got me!", "group": "win" },

    { "id": "good-game", "text": "Good game!", "group": "loss" },
    { "id": "so-close", "text": "So close!", "group": "loss" },
    { "id": "tough-one", "text": "Tough one!", "group": "loss" },

    { "id": "nice-day", "text": "Nice day!", "group": "ambient" },
    { "id": "no-worries", "text": "No worries.", "group": "decline" },

    { "id": "again", "text": "Wanna go again?", "group": "close" },
    { "id": "maybe-next-time", "text": "Maybe next time.", "group": "close" },
    { "id": "see-you", "text": "See you next time.", "group": "close" },

    { "id": "hiya", "text": "Hiya!", "group": "greeting", "alternate": true },
    { "id": "fancy-a-game", "text": "Fancy a game?", "group": "play", "alternate": true },
    { "id": "one-more", "text": "One more?", "group": "close", "alternate": true },
    { "id": "catch-you-later", "text": "Catch you later!", "group": "close", "alternate": true },
    { "id": "friends-now", "text": "We're friends now!", "group": "friendship", "alternate": true },
    { "id": "good-luck", "text": "Good luck!", "group": "play", "alternate": true }
  ],
  "hooks": {
    "stranger": ["greet", "be-friends"],
    "friend": ["hello", "good-to-see"],
    "accepted": ["yay", "friends-now"],
    "declined": ["no-worries", "maybe-next-time"],
    "companion": ["hey-buddy", "greet"],

    "social.greet": ["greet", "hello"],
    "social.chat": ["nice-day"],
    "social.invite": ["lets-play", "got-time"],
    "social.friend": ["got-time", "again"],
    "social.npcGamePrompt": ["watch-this"],

    "minigame.win": ["nice-one", "well-played", "you-got-me"],
    "minigame.loss": ["good-game", "tough-one"],
    "minigame.draw": ["good-game", "so-close"],
    "minigame.abandoned": ["maybe-next-time", "see-you"],

    "game.start": ["good-luck"],
    "replay": ["again", "one-more"],
    "close": ["see-you", "catch-you-later"]
  }
}
